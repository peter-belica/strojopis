{
  "name": "strojopis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:content": "node scripts/validate-content.js",
    "validate:licenses": "node scripts/validate-licenses.js",
    "build": "npm run validate:content && npm run validate:licenses && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "report:agents": "python3 scripts/agent-report.py",
    "test:report": "python3 -m unittest discover -s tests -p agent_report_test.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
