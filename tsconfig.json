{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strictNullChecks": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false
  },
  "include": [
    "assets/js/**/*.js",
    "assets/js/**/*.d.ts"
  ]
}
